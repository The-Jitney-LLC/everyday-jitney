# Copy this file to .env for local runs. On your host (Render, Railway, etc.)
# enter the same names in its "Environment" settings instead.
# Never commit the real .env file.

PORT=8787

# Public address of the storefront (Stripe sends shoppers back here after paying)
SITE_URL=https://www.everydayjitney.com

# Sites allowed to call this server, comma separated (no trailing slashes)
ALLOWED_ORIGINS=https://www.everydayjitney.com,https://everydayjitney.com

# ---- Stripe (payments) ----
# Stripe Dashboard > Developers > API keys. Use the sk_test_ key until you've placed a test order.
STRIPE_SECRET_KEY=
# Countries you ship to, comma separated (two-letter codes)
SHIP_COUNTRIES=US
# Stripe Dashboard > Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# true = Stripe Tax calculates and collects sales tax (add your Michigan registration in Stripe first)
STRIPE_AUTOMATIC_TAX=false
# Optional flat shipping in cents (e.g. 599 = $5.99) and free-shipping threshold in cents. 0 = off.
FLAT_SHIPPING_CENTS=0
FREE_SHIPPING_OVER_CENTS=0

# ---- Shopify (catalog prices are checked here before every checkout) ----
SHOPIFY_STORE_DOMAIN=sihxha-06.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_API_VERSION=2026-07
# Shopify Admin > Settings > Apps > Develop apps > your app > Admin API access token (shpat_...)
# Scopes: write_orders, read_products, read_inventory. Used to create the paid order after each Stripe payment.
SHOPIFY_ADMIN_TOKEN=
# Only needed if you also send Shopify order webhooks here
SHOPIFY_WEBHOOK_SECRET=

# ---- Make ----
# Checkout and order events: the Compass Rose Stripe Checkout Test custom webhook
MAKE_ORDERS_WEBHOOK_URL=
# Sales ledger rows: the "Everyday Jitney - Sales Ledger" custom webhook
# (feeds Sales Worksheet V1 > Stripe Sales Ledger)
MAKE_SALES_WEBHOOK_URL=
# ICP beacon batches: a separate custom webhook (not the Stripe "Watch Events" one)
MAKE_ICP_WEBHOOK_URL=

# Stripe's own payment events (paid, failed, refunded, disputed) go from Stripe
# straight to your Stripe "Watch Events" webhook in Make, not through this server.
# Keep webhook URLs out of GitHub: anyone with one can post to your scenario.

# true = this server also hosts the storefront from /public
SERVE_STATIC=false
